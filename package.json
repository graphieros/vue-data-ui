{
    "name": "vue-data-ui",
    "private": false,
    "version": "3.28.2",
    "type": "module",
    "description": "A user-empowering data visualization Vue 3 components library for eloquent data storytelling",
    "keywords": [
        "3d bar",
        "Vue",
        "accelerometer",
        "age pyramid",
        "annotator",
        "candlestick",
        "chart",
        "cluster",
        "dashboard",
        "data storytelling",
        "data visualization",
        "donut evolution",
        "donut",
        "dumbbell",
        "funnel",
        "galaxy",
        "gauge",
        "graph",
        "heatmap",
        "kpi",
        "line",
        "molecule",
        "mood radar",
        "quadrant",
        "quick chart",
        "radar",
        "rating",
        "relationship circle",
        "rings",
        "scatter",
        "screenshot",
        "skeleton",
        "smiley",
        "sparkbar",
        "sparkline",
        "stackbar",
        "table heatmap",
        "table",
        "thermometer",
        "tiremarks",
        "tree",
        "treemap",
        "waffle",
        "wheel",
        "wordcloud",
        "circle packing",
        "dag"
    ],
    "author": "Alec Lloyd Probert",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphieros/vue-data-ui.git"
    },
    "homepage": "https://vue-data-ui.graphieros.com/",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/vue-data-ui.d.ts",
            "import": "./dist/vue-data-ui.js",
            "default": "./dist/vue-data-ui.js"
        },
        "./utils": {
            "types": "./dist/types/utils.d.ts",
            "import": "./dist/utils.js"
        },
        "./composables": {
            "types": "./dist/types/composables.d.ts",
            "import": "./dist/composables.js"
        },
        "./ssr/*": {
            "types": "./dist/types/ssr.d.ts",
            "import": "./dist/ssr.js"
        },
        "./*": {
            "types": "./dist/types/*.d.ts",
            "import": "./dist/components/*.js",
            "default": "./dist/components/*.js"
        },
        "./style.css": {
            "style": "./dist/style.css",
            "default": "./dist/style.css"
        }
    },
    "sideEffects": [
        "**/*.css"
    ],
    "module": "dist/vue-data-ui.js",
    "types": "dist/types/vue-data-ui.d.ts",
    "scripts": {
        "dev": "node add-dev-dep.cjs && pnpm install && vite",
        "clean": "node cleanup.cjs",
        "build": "pnpm run clean && vite build --mode production && node copy-types.cjs && pnpm install",
        "prod": "pnpm run pretty && node del-dev-dep.cjs && node check-types.cjs && pnpm run test:all && pnpm run clean && vite build --mode production && node copy-types.cjs && node post-build.cjs",
        "test": "vitest run --config vitest.config.js",
        "test:w": "vitest --config vitest.config.js",
        "preprod": "node check-types.cjs && pnpm run pretty:fix && node del-dev-dep.cjs && pnpm run clean && vite build --mode production && node copy-types.cjs && node post-build.cjs",
        "pubprod": "node check-types.cjs && node del-dev-dep.cjs && pnpm run clean && vite build --mode production && node copy-types.cjs && node post-build.cjs",
        "types": "node check-types.cjs",
        "pretty": "prettier . --check",
        "pretty:fix": "prettier . --write",
        "storybook": "storybook dev -p 6006 --no-open",
        "build:storybook": "storybook build",
        "test:storybook": "vitest run --config vitest.storybook.config.js",
        "test:unit": "vitest run --config vitest.config.js",
        "test:all": "pnpm run test:unit && pnpm run test:storybook"
    },
    "peerDependencies": {
        "jspdf": ">=3.0.1",
        "vue": ">=3.3.0"
    },
    "peerDependenciesMeta": {
        "jspdf": {
            "optional": true
        }
    },
    "devDependencies": {
        "@storybook/addon-docs": "^10.6.3",
        "@storybook/addon-vitest": "^10.6.3",
        "@storybook/vue3-vite": "^10.6.3",
        "@types/node": "^25.5.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/browser-playwright": "^5.0.5",
        "@vue/compiler-dom": "3.5.44",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^29.1.1",
        "playwright": "^1.64.1",
        "prettier": "3.8.1",
        "remove-attr": "^0.0.13",
        "rolldown": "1.2.15",
        "sass": "^1.57.1",
        "simple-git": "^4.0.2",
        "storybook": "^10.6.3",
        "typescript": "^6.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.0",
        "vue": "^3.5.44"
    },
    "packageManager": "pnpm@12.15.0"
}
